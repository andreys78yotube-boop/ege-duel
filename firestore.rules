rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Профиль игрока: читать и менять может только сам владелец
    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'bio', 'photo', 'preset', 'color', 'stats', 'days', 'updatedAt'])
        && (!('days' in request.resource.data) || (request.resource.data.days is list && request.resource.data.days.size() <= 400))
        && request.resource.data.name is string && request.resource.data.name.size() <= 24
        && request.resource.data.bio is string && request.resource.data.bio.size() <= 160
        && (request.resource.data.photo == null || (request.resource.data.photo is string && request.resource.data.photo.size() <= 60000))
        && request.resource.data.preset is int && request.resource.data.color is int
        && request.resource.data.stats is map;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
